# ===== Desenvolvimento local (SQLite) =====
# Relativo a prisma/sqlite/ (schema gerado para dev). Em produção, veja DEPLOY.md.
DATABASE_URL="file:../dev.db"

# Provedor de IA: "anthropic" (com chave) ou "mock" (respostas de exemplo, só para dev)
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Fotos da agenda: "local" (disco, fora de /public) ou "supabase" (bucket privado)
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="8"

# URL pública do app (usada no link de recuperação de senha)
APP_URL="http://localhost:3000"

# Quem pode criar turmas (e-mails separados por vírgula). As famílias entram pelo código de convite.
# Vazio: em dev qualquer conta cria; em produção, ninguém.
CLASS_CREATOR_EMAILS=""
