// Agenda da Turma — schema relacional (ESPECIFICACAO.md §37).
// Este é o schema oficial (PostgreSQL / Supabase, usado em produção e nas migrações).
// Para desenvolvimento local e testes, scripts/sqlite-schema.mjs gera uma cópia SQLite
// (prisma/sqlite/schema.prisma) — edite só este arquivo.
// Campos de domínio (role, status, tipo…) são String validados na aplicação (src/lib/domain.ts),
// o que mantém o schema portável entre SQLite e PostgreSQL e permite novos níveis no futuro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL = pooler (porta 6543, ?pgbouncer=true); DIRECT_URL = conexão direta (5432), usada nas migrações.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?
  status       String   @default("ativo") // ativo | inativo
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  memberships   ClassMember[]
  events        Event[]        @relation("EventCreator")
  history       EventHistory[]
  notifications Notification[]
  uploads       Upload[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  classes   Class[]

  @@map("schools")
}

model Class {
  id         String   @id @default(cuid())
  schoolId   String   @map("school_id")
  name       String
  year       Int
  emoji      String   @default("🌻")
  inviteCode String   @unique @map("invite_code")
  status     String   @default("ativa") // ativa | arquivada
  createdAt  DateTime @default(now()) @map("created_at")

  school  School        @relation(fields: [schoolId], references: [id])
  members ClassMember[]
  events  Event[]
  uploads Upload[]

  @@map("classes")
}

model ClassMember {
  id       String   @id @default(cuid())
  classId  String   @map("class_id")
  userId   String   @map("user_id")
  role     String   @default("MEMBRO") // ADMIN | MEMBRO | VISUALIZADOR
  status   String   @default("pendente") // pendente | ativo | removido | saiu | recusado
  joinedAt DateTime @default(now()) @map("joined_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_members")
}

model Event {
  id                    String    @id @default(cuid())
  classId               String    @map("class_id")
  createdBy             String    @map("created_by")
  title                 String
  description           String
  eventType             String    @map("event_type")
  // Datas e horários "de parede" no fuso America/Sao_Paulo (YYYY-MM-DD / HH:MM):
  // um compromisso escolar é um dia do calendário local, não um instante UTC.
  startDate             String    @map("start_date")
  endDate               String?   @map("end_date")
  startTime             String?   @map("start_time")
  endTime               String?   @map("end_time")
  location              String?
  amount                Decimal?
  authorizationRequired Boolean   @default(false) @map("authorization_required")
  notes                 String?
  link                  String?
  responsible           String?
  status                String    @default("ativo") // ativo | concluido | cancelado
  source                String    @default("manual") // manual | foto
  uploadId              String?   @map("upload_id")
  originalImageUrl      String?   @map("original_image_url")
  sourceText            String?   @map("source_text")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by")

  class         Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator       User            @relation("EventCreator", fields: [createdBy], references: [id])
  upload        Upload?         @relation(fields: [uploadId], references: [id])
  materials     EventMaterial[]
  reminders     EventReminder[]
  history       EventHistory[]
  notifications Notification[]

  @@index([classId, startDate])
  @@map("events")
}

model EventMaterial {
  id          String @id @default(cuid())
  eventId     String @map("event_id")
  description String
  position    Int    @default(0)
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_materials")
}

model EventReminder {
  id           String @id @default(cuid())
  eventId      String @map("event_id")
  reminderType String @map("reminder_type") // 7d | 3d | 1d
  reminderDate String @map("reminder_date") // YYYY-MM-DD
  status       String @default("pendente") // pendente | enviado | cancelado
  event        Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, reminderType])
  @@map("event_reminders")
}

model EventHistory {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  action    String // criado | alterado | excluido
  oldData   String?  @map("old_data") // JSON
  newData   String?  @map("new_data") // JSON
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId, createdAt])
  @@map("event_history")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  eventId   String?   @map("event_id")
  type      String // lembrete | membro_pendente | membro_aprovado
  title     String
  message   String
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// Tentativas de login / recuperação / leitura por IA, para o limite de tentativas (§38).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Foto da agenda enviada para leitura por IA. Guardada fora de /public e servida só
// por rota autenticada (/api/images/{id}) para membros da turma.
model Upload {
  id          String   @id @default(cuid())
  classId     String   @map("class_id")
  userId      String   @map("user_id")
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  size        Int
  transcript  String?
  createdAt   DateTime @default(now()) @map("created_at")

  class  Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])
  events Event[]

  @@map("uploads")
}
